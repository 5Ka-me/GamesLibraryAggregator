{
  "name": "steam-egs-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop launcher for the Steam + EGS library aggregator",
  "author": "5Ka",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fetch:legendary": "node scripts/fetch-legendary.mjs",
    "package": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@app/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
