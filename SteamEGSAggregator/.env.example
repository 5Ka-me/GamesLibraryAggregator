# Copy to .env and fill in real values. `docker compose` loads .env automatically.

# --- Steam (REQUIRED) ---
# Server-side Steam Web API key: https://steamcommunity.com/dev/apikey
# Users of the web app never enter keys — they just "Sign in through Steam".
STEAM_API_KEY=

# --- URLs (defaults fit local docker compose) ---
# Where the browser reaches the web app (CORS + post-login redirect).
WEB_ORIGIN=http://localhost:3000
# Where the browser reaches the API (OpenID return URL).
API_PUBLIC_URL=http://localhost:8080
# Backend address baked into the web bundle.
REACT_APP_API_URL=http://localhost:8080

ASPNETCORE_ENVIRONMENT=Production
